<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Mutabaah & Mentoring Digital Pro - Lingkar Bertumbuh</title>
  
  <!-- Optimization for Mobile / PWA -->
  <meta name="theme-color" content="#030712">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <!-- Canvas Confetti CDN -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] },
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              900: '#064e3b'
            },
            dark: {
              800: '#1e293b',
              900: '#0f172a',
              950: '#030712'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-tap-highlight-color: transparent;
      background-color: #030712;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .glass-card {
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    }
    .glass-nav {
      background: rgba(3, 7, 18, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glass-input {
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.25s ease;
    }
    .glass-input:focus {
      border-color: #10b981;
      box-shadow: 0 0 25px rgba(16, 185, 129, 0.3);
    }

    .glow-gold { box-shadow: 0 0 30px -5px rgba(245, 158, 11, 0.35); }
    .glow-silver { box-shadow: 0 0 25px -5px rgba(203, 213, 225, 0.2); }
    .glow-bronze { box-shadow: 0 0 25px -5px rgba(217, 119, 6, 0.25); }
    .glow-emerald { box-shadow: 0 10px 30px -5px rgba(16, 185, 129, 0.35); }

    .bg-blob-1 {
      position: fixed;
      top: -10%; left: 50%; transform: translateX(-50%);
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, rgba(3, 7, 18, 0) 70%);
      pointer-events: none; z-index: -10;
    }
  </style>
</head>
<body class="text-slate-100 min-h-screen pb-28 relative selection:bg-brand-500 selection:text-white">

  <!-- BACKGROUND AMBIENT GLOW -->
  <div class="bg-blob-1"></div>

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toastContainer" class="fixed top-5 right-4 left-4 md:left-auto md:w-96 z-50 flex flex-col gap-3 pointer-events-none"></div>

  <!-- HEADER NAVBAR -->
  <header class="sticky top-0 z-40 glass-nav text-white">
    <div class="max-w-4xl mx-auto px-4 py-3.5 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-brand-600 via-emerald-500 to-teal-300 flex items-center justify-center font-black text-xl shadow-lg glow-emerald border border-brand-400/40 shrink-0">
          🌱
        </div>
        <div class="truncate">
          <h1 class="font-black text-base md:text-lg leading-tight truncate text-slate-100 tracking-tight">Lingkar Bertumbuh</h1>
          <p class="text-[11px] text-slate-400 truncate flex items-center gap-1.5 font-medium">
            <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span> Murabbi: <span class="font-bold text-brand-400">Rio Friyadi</span>
          </p>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <span id="roleBadge" class="hidden sm:inline-flex items-center gap-1.5 text-[10px] font-extrabold px-3 py-1.5 rounded-xl bg-slate-900/90 text-slate-300 border border-slate-700/80">
          👤 Anggota
        </span>
        <button onclick="handleAdminToggle()" id="btnSwitchAdmin" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 active:scale-95 text-slate-950 font-black text-xs px-3.5 py-2 rounded-xl shadow-lg glow-gold transition flex items-center gap-1.5 cursor-pointer">
          <i class="fa-solid fa-shield-halved text-xs" id="adminLockIcon"></i> <span id="btnAdminText">Admin</span>
        </button>
      </div>
    </div>

    <!-- TABS NAVIGATION -->
    <div class="bg-slate-950/80 border-t border-white/5">
      <div class="max-w-4xl mx-auto px-2 flex overflow-x-auto text-xs font-bold text-slate-400 no-scrollbar">
        <button onclick="switchTab('tabLeaderboard')" id="nav-tabLeaderboard" class="nav-tab px-4 py-3 border-b-2 border-brand-500 text-white flex items-center gap-2 whitespace-nowrap transition-all">
          <i class="fa-solid fa-trophy text-amber-400"></i> Leaderboard
        </button>
        <button onclick="switchTab('tabForm')" id="nav-tabForm" class="nav-tab px-4 py-3 border-b-2 border-transparent hover:text-white flex items-center gap-2 whitespace-nowrap transition-all">
          <i class="fa-solid fa-pen-to-square text-brand-400"></i> Input Mutabaah
        </button>
        <button onclick="switchTab('tabDashboard')" id="nav-tabDashboard" class="nav-tab px-4 py-3 border-b-2 border-transparent hover:text-white flex items-center gap-2 whitespace-nowrap transition-all">
          <i class="fa-solid fa-chart-column text-cyan-400"></i> Rekap & Grafik
        </button>
        <button onclick="switchTab('tabAdmin')" id="nav-tabAdmin" class="nav-tab px-4 py-3 border-b-2 border-transparent hover:text-white flex items-center gap-2 whitespace-nowrap transition-all hidden admin-only">
          <i class="fa-solid fa-sliders text-amber-400"></i> Kelola Admin
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 mt-5 space-y-6">

    <!-- STATUS BAR INTERIOR DATA -->
    <div class="p-3.5 glass-card rounded-2xl shadow-xl flex items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2.5 text-slate-300 font-semibold truncate">
        <span class="relative flex h-2.5 w-2.5 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-500"></span>
        </span>
        <span class="truncate text-slate-200">Sistem Data Standalone: <span class="text-brand-400 font-bold">Siap & Aktif</span></span>
      </div>
      <span class="text-[10px] bg-slate-800 text-slate-300 px-3 py-1 rounded-xl border border-slate-700 font-bold">Autosave Active</span>
    </div>

    <!-- ================= TAB 1: KLASEMEN & PODIUM 3D ================= -->
    <section id="tabLeaderboard" class="tab-content space-y-6">
      <div class="glass-card p-5 md:p-8 rounded-3xl shadow-2xl relative overflow-hidden">
        
        <div class="text-center max-w-md mx-auto mb-8">
          <span class="bg-amber-500/10 text-amber-400 text-[11px] font-black px-4 py-1.5 rounded-full border border-amber-500/20 inline-block mb-2 uppercase tracking-wider">
            ✨ Fastabiqul Khairat
          </span>
          <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">Klasemen Pekanan</h2>
          <p class="text-xs text-slate-400 mt-1.5 font-medium">Peringkat Amalan Yaumiyah & Olahraga Anggota</p>
        </div>

        <!-- PODIUM TOP 3 -->
        <div id="podiumSection" class="grid grid-cols-3 gap-2.5 md:gap-5 mb-8 items-end min-h-[200px]"></div>

        <!-- GAMIFICATION BADGES LEGEND -->
        <div class="p-3.5 glass-input rounded-2xl mb-6 flex flex-wrap items-center justify-center gap-2.5 text-[10px] font-extrabold text-slate-300">
          <span class="flex items-center gap-1 bg-amber-500/10 text-amber-300 border border-amber-500/20 px-2.5 py-1 rounded-xl">
            🌟 Istiqomah (&gt;100pt)
          </span>
          <span class="flex items-center gap-1 bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 px-2.5 py-1 rounded-xl">
            🕌 Laskar Masjid
          </span>
          <span class="flex items-center gap-1 bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 px-2.5 py-1 rounded-xl">
            🏃‍♂️ Olahragawan
          </span>
        </div>

        <!-- RANKINGS LIST -->
        <div class="space-y-3" id="rankingList"></div>
      </div>
    </section>

    <!-- ================= TAB 2: INPUT MUTABAAH & OLAHRAGA ================= -->
    <section id="tabForm" class="tab-content hidden space-y-5">
      
      <div class="glass-card p-5 rounded-3xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="w-full md:w-2/3 space-y-1.5">
          <label class="block text-[11px] font-black uppercase tracking-wider text-brand-400">Nama Lengkap Anggota:</label>
          <input type="text" id="userNamaInput" placeholder="Ketik nama kamu di sini..." oninput="updateLiveScore()" class="w-full p-3.5 glass-input rounded-2xl font-bold text-slate-100 text-sm outline-none">
        </div>
        <div class="w-full md:w-1/3 bg-gradient-to-br from-slate-900 via-slate-950 to-brand-950/40 p-4 rounded-2xl text-center border border-brand-500/30 shadow-lg glow-emerald">
          <p class="text-[10px] uppercase font-black text-slate-400 tracking-wider">Total Skor Live</p>
          <p id="liveCalculatedScore" class="text-3xl font-black text-brand-400 mt-0.5">0 <span class="text-xs text-slate-300 font-bold">pts</span></p>
        </div>
      </div>

      <form id="mutabaahForm" onsubmit="saveMutabaah(event)" class="space-y-5">
        
        <!-- SECTION 1: ABSENSI MENTORING -->
        <div class="glass-card p-5 md:p-6 rounded-3xl shadow-xl space-y-4 border-l-4 border-l-cyan-500">
          <div class="border-b border-slate-800 pb-3 flex justify-between items-center">
            <h3 class="font-black text-slate-100 text-sm flex items-center gap-2">
              <i class="fa-solid fa-users text-cyan-400"></i> Absensi Mentoring Pekanan
            </h3>
            <span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">Wajib Isi</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 glass-input rounded-2xl space-y-2">
              <label class="font-bold text-xs text-slate-200 block">Pilih Pekan Mentoring:</label>
              <select id="inputPekan" class="w-full p-3 bg-slate-950 border border-slate-700/80 rounded-xl text-xs font-bold text-slate-100 outline-none cursor-pointer">
                <option value="Pekan 1">Pekan 1</option>
                <option value="Pekan 2">Pekan 2</option>
                <option value="Pekan 3">Pekan 3</option>
                <option value="Pekan 4">Pekan 4</option>
              </select>
            </div>

            <div class="p-4 glass-input rounded-2xl space-y-2">
              <label class="font-bold text-xs text-slate-200 block">Status Kehadiran Mentoring:</label>
              <select id="statusMentoring" class="w-full p-3 bg-slate-950 border border-slate-700/80 rounded-xl text-xs font-bold text-slate-100 outline-none cursor-pointer">
                <option value="Hadir">✅ Hadir Mentoring</option>
                <option value="Izin">🟡 Izin Syar'i</option>
                <option value="Alfa">❌ Alfa (Tanpa Keterangan)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- SECTION 2: AMALAN YAUMI & OLAHRAGA -->
        <div class="glass-card p-5 md:p-6 rounded-3xl shadow-xl space-y-4">
          <div class="border-b border-slate-800 pb-3">
            <h3 class="font-black text-slate-100 text-sm flex items-center gap-2">
              <i class="fa-solid fa-kaaba text-brand-400"></i> Amalan Yaumi & Olahraga Pekanan
            </h3>
          </div>

          <div class="p-4 glass-input rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div>
              <p class="font-bold text-sm text-slate-100">📖 Tilawah Al-Qur'an <span class="text-xs font-semibold text-brand-400">(+20 pt/juz)</span></p>
              <p class="text-[11px] text-slate-400">Target Min: 3.5 Juz / pekan</p>
            </div>
            <div class="flex items-center gap-2">
              <input type="number" step="0.5" id="tilawahJuz" placeholder="0" min="0" oninput="updateLiveScore()" class="w-24 p-2.5 bg-slate-950 border border-slate-700 rounded-xl font-black text-center text-sm text-white outline-none focus:border-brand-500">
              <span class="text-xs font-bold text-slate-400">Juz</span>
            </div>
          </div>

          <div class="p-4 glass-input rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div>
              <p class="font-bold text-sm text-slate-100">🕌 Shalat Jamaah Masjid <span class="text-xs font-semibold text-brand-400">(+2 pt/waktu)</span></p>
              <p class="text-[11px] text-slate-400">Target Min: 35 Waktu / pekan</p>
            </div>
            <div class="flex items-center gap-2">
              <input type="number" id="sholatMasjid" placeholder="0" min="0" max="35" oninput="updateLiveScore()" class="w-24 p-2.5 bg-slate-950 border border-slate-700 rounded-xl font-black text-center text-sm text-white outline-none focus:border-brand-500">
              <span class="text-xs font-bold text-slate-400">Waktu</span>
            </div>
          </div>

          <div class="p-4 glass-input rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div>
              <p class="font-bold text-sm text-slate-100">🏃‍♂️ Durasi Olahraga <span class="text-xs font-semibold text-brand-400">(+1 pt/5 menit)</span></p>
              <p class="text-[11px] text-slate-400">Jogging, Futsal, Badminton, Badminton, Gym, dll.</p>
            </div>
            <div class="flex items-center gap-2">
              <input type="number" id="olahragaMenit" placeholder="0" min="0" oninput="updateLiveScore()" class="w-24 p-2.5 bg-slate-950 border border-slate-700 rounded-xl font-black text-center text-sm text-white outline-none focus:border-brand-500">
              <span class="text-xs font-bold text-slate-400">Menit</span>
            </div>
          </div>

          <div class="p-4 glass-input rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div>
              <p class="font-bold text-sm text-slate-100">🌙 Shalat Tahajud & Dhuha <span class="text-xs font-semibold text-brand-400">(+10 pt/hari)</span></p>
            </div>
            <div class="flex items-center gap-2">
              <input type="number" id="tahajudHari" placeholder="0" min="0" max="7" oninput="updateLiveScore()" class="w-24 p-2.5 bg-slate-950 border border-slate-700 rounded-xl font-black text-center text-sm text-white outline-none focus:border-brand-500">
              <span class="text-xs font-bold text-slate-400">Hari</span>
            </div>
          </div>
        </div>

        <!-- SECTION 3: TARGET & CATATAN -->
        <div class="glass-card p-5 md:p-6 rounded-3xl shadow-xl space-y-4">
          <div class="border-b border-slate-800 pb-3">
            <h3 class="font-black text-slate-100 text-sm flex items-center gap-2">
              <i class="fa-solid fa-graduation-cap text-brand-400"></i> Target & Catatan Evaluasi
            </h3>
          </div>

          <div>
            <label class="font-bold text-xs text-slate-300 block mb-1.5">Catatan Evaluasi / Kendala Pekan Ini:</label>
            <textarea id="catatanKendala" rows="2" placeholder="Tuliskan komitmen atau kendala untuk dievaluasi saat mentoring..." class="w-full p-3.5 text-xs glass-input rounded-2xl text-slate-100 outline-none focus:border-brand-500"></textarea>
          </div>
        </div>

        <button type="submit" id="btnSaveMutabaah" class="w-full bg-gradient-to-r from-brand-600 via-emerald-500 to-teal-400 hover:opacity-95 active:scale-[0.98] text-slate-950 font-black py-4 px-6 rounded-2xl shadow-xl glow-emerald transition flex items-center justify-center gap-2 text-sm cursor-pointer">
          <i class="fa-solid fa-cloud-arrow-up text-lg"></i> Simpan Data Mutabaah
        </button>

      </form>
    </section>

    <!-- ================= TAB 3: REKAP & GRAFIK VISUAL ================= -->
    <section id="tabDashboard" class="tab-content hidden space-y-5">
      <div class="flex justify-between items-center bg-gradient-to-r from-emerald-950 via-slate-900 to-slate-950 p-4 rounded-3xl border border-emerald-500/30 shadow-xl">
        <div>
          <h3 class="font-black text-sm text-white">Evaluasi & Rekap Analytics</h3>
          <p class="text-[11px] text-slate-400 font-medium">Rangkuman amalan & grafik statistik kelompok</p>
        </div>
        <button onclick="shareToWhatsApp()" class="bg-gradient-to-r from-emerald-500 to-emerald-400 hover:opacity-95 active:scale-95 text-slate-950 font-black text-xs px-4 py-2.5 rounded-2xl shadow-lg glow-emerald transition flex items-center gap-2 shrink-0 cursor-pointer">
          <i class="fa-brands fa-whatsapp text-lg"></i> Kirim WA
        </button>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div class="glass-card p-4 rounded-2xl border border-white/5 text-center">
          <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Total Rekor</p>
          <p id="statHadirMentoring" class="text-xl md:text-2xl font-black text-emerald-400 mt-1">0 Kader</p>
        </div>
        <div class="glass-card p-4 rounded-2xl border border-white/5 text-center">
          <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Total Poin Group</p>
          <p id="statTotalPoin" class="text-xl md:text-2xl font-black text-cyan-400 mt-1">0 pts</p>
        </div>
        <div class="glass-card p-4 rounded-2xl border border-white/5 text-center">
          <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Anggota Aktif</p>
          <p id="statTotalKader" class="text-xl md:text-2xl font-black text-amber-400 mt-1">0 Kader</p>
        </div>
      </div>

      <div class="glass-card p-5 rounded-3xl space-y-4">
        <h4 class="font-black text-xs text-cyan-400 uppercase tracking-wider flex items-center gap-2">
          <i class="fa-solid fa-chart-simple"></i> Perbandingan Skor Anggota
        </h4>
        <div class="h-60 relative w-full">
          <canvas id="pointsChart"></canvas>
        </div>
      </div>

      <div class="glass-card p-5 md:p-6 rounded-3xl space-y-3">
        <h4 class="font-black text-xs text-brand-400 uppercase tracking-wider flex items-center gap-2">
          <i class="fa-solid fa-list-check"></i> Rincian Capaian Anggota
        </h4>
        <div id="rekapKaderList" class="space-y-3">
          <p class="text-center text-xs text-slate-400 py-6">Memuat rekap data...</p>
        </div>
      </div>
    </section>

    <!-- ================= TAB
