<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Lingkar Bertumbuh - Mutabaah & Olahraga</title>

  <!-- PWA & Mobile Meta -->
  <meta name="theme-color" content="#030712">
  <meta name="apple-mobile-web-app-capable" content="yes">

  <!-- Tailwind CSS & Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <!-- Firebase SDK (Tanpa Spreadsheet!) -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getFirestore, collection, addDoc, onSnapshot, doc, updateDoc, deleteDoc, query, orderBy } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

    // 🔴 GANTI DENGAN KODE FIREBASE CONFIG KAMU SENDIRI DARI TAHAP 1 🔴
    const firebaseConfig = {
      apiKey: "AIzaSy...",
      authDomain: "lingkar-bertumbuh.firebaseapp.com",
      projectId: "lingkar-bertumbuh",
      storageBucket: "lingkar-bertumbuh.appspot.com",
      messagingSenderId: "123456789",
      appId: "1:123456789:web:abcdef"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);
    window.db = db;
    window.dbMethods = { collection, addDoc, onSnapshot, doc, updateDoc, deleteDoc, query, orderBy };
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #030712; -webkit-tap-highlight-color: transparent; }
    .glass-card { background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); }
    .glass-input { background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); }
    .glow-gold { box-shadow: 0 0 25px rgba(245, 158, 11, 0.3); }
    .glow-emerald { box-shadow: 0 0 25px rgba(16, 185, 129, 0.3); }
  </style>
</head>
<body class="text-slate-100 min-h-screen pb-24 relative selection:bg-emerald-500 selection:text-white">

  <!-- Toast Notification -->
  <div id="toast" class="fixed top-4 left-4 right-4 md:left-auto md:w-80 z-50 hidden p-4 rounded-2xl text-xs font-bold shadow-2xl transition-all"></div>

  <!-- HEADER -->
  <header class="sticky top-0 z-40 glass-card border-b border-white/10 text-white">
    <div class="max-w-xl mx-auto px-4 py-3.5 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-500 text-slate-950 flex items-center justify-center font-black text-xl shadow-lg glow-emerald">🌱</div>
        <div>
          <h1 class="font-black text-base leading-tight">Lingkar Bertumbuh</h1>
          <p class="text-[11px] text-slate-400 font-medium">Murabbi: <span class="text-emerald-400 font-bold">Rio Friyadi</span></p>
        </div>
      </div>
      <button onclick="toggleAdmin()" id="btnAdmin" class="bg-amber-500 text-slate-950 font-black text-xs px-3.5 py-2 rounded-xl shadow-lg glow-gold active:scale-95 transition">
        <i class="fa-solid fa-shield-halved mr-1"></i> Admin
      </button>
    </div>

    <!-- TABS -->
    <div class="bg-slate-950/80 border-t border-white/5">
      <div class="max-w-xl mx-auto flex text-xs font-bold text-slate-400">
        <button onclick="switchTab('tabLeaderboard')" id="nav-tabLeaderboard" class="flex-1 py-3 border-b-2 border-emerald-500 text-white text-center">🏆 Leaderboard</button>
        <button onclick="switchTab('tabForm')" id="nav-tabForm" class="flex-1 py-3 border-b-2 border-transparent text-center">📝 Input Amalan</button>
      </div>
    </div>
  </header>

  <main class="max-w-xl mx-auto px-4 mt-5 space-y-5">

    <!-- TAB 1: LEADERBOARD REAL-TIME -->
    <section id="tabLeaderboard" class="space-y-4">
      <div class="glass-card p-5 rounded-3xl text-center relative overflow-hidden">
        <span class="bg-emerald-500/10 text-emerald-400 text-[10px] font-black px-3 py-1 rounded-full border border-emerald-500/20 uppercase tracking-widest">Live Sync Realtime</span>
        <h2 class="text-2xl font-black text-white mt-2">Klasemen Pekanan</h2>
        <p class="text-xs text-slate-400">Mutabaah Yaumiyah & Aktivitas Olahraga</p>

        <!-- TOP 3 PODIUM -->
        <div id="podium" class="grid grid-cols-3 gap-2 mt-6 items-end min-h-[160px]"></div>
      </div>

      <!-- LIST RANKING -->
      <div class="glass-card p-4 rounded-3xl space-y-2.5" id="rankingList">
        <p class="text-center text-xs text-slate-500 py-6">Memuat data leaderboard...</p>
      </div>
    </section>

    <!-- TAB 2: INPUT MUTABAAH & OLAHRAGA -->
    <section id="tabForm" class="hidden space-y-4">
      <div class="glass-card p-5 rounded-3xl space-y-4">
        <h2 class="text-lg font-black text-emerald-400 flex items-center gap-2">
          <i class="fa-solid fa-pen-to-square"></i> Input Mutabaah & Olahraga
        </h2>

        <form onsubmit="simpanData(event)" class="space-y-3 text-xs">
          <div>
            <label class="block font-bold text-slate-300 mb-1">Nama Anggota <span class="text-rose-400">*</span></label>
            <input type="text" id="inputNama" required placeholder="Masukkan nama kamu..." class="w-full p-3 glass-input rounded-xl text-white outline-none font-bold">
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-300 mb-1">Pekan Ke-</label>
              <select id="inputPekan" class="w-full p-3 bg-slate-950 border border-slate-700 rounded-xl text-white font-bold outline-none">
                <option value="Pekan 1">Pekan 1</option>
                <option value="Pekan 2">Pekan 2</option>
                <option value="Pekan 3">Pekan 3</option>
                <option value="Pekan 4">Pekan 4</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-300 mb-1">Tilawah (Juz) <span class="text-emerald-400">(+20pt/juz)</span></label>
              <input type="number" step="0.5" id="inputTilawah" value="0" min="0" oninput="hitungPoin()" class="w-full p-3 glass-input rounded-xl text-white font-bold outline-none">
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-300 mb-1">Shalat Masjid (Waktu) <span class="text-emerald-400">(+2pt)</span></label>
              <input type="number" id="inputSholat" value="0" min="0" max="35" oninput="hitungPoin()" class="w-full p-3 glass-input rounded-xl text-white font-bold outline-none">
            </div>
            <div>
              <label class="block font-bold text-slate-300 mb-1">Olahraga (Menit) <span class="text-emerald-400">(+1pt/5mnt)</span></label>
              <input type="number" id="inputOlahraga" value="0" min="0" oninput="hitungPoin()" class="w-full p-3 glass-input rounded-xl text-white font-bold outline-none">
            </div>
          </div>

          <div class="p-3 bg-slate-950/80 rounded-2xl border border-emerald-500/30 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase">Estimasi Total Poin</span>
            <p id="totalPoinText" class="text-2xl font-black text-emerald-400">0 Poin</p>
          </div>

          <button type="submit" id="btnSubmit" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black py-3.5 rounded-xl shadow-lg glow-emerald transition cursor-pointer text-sm">
            Kirim Mutabaah Sekarang
          </button>
        </form>
      </div>
    </section>

  </main>

  <!-- MODAL EDIT ADMIN -->
  <div id="modalEdit" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="glass-card w-full max-w-sm rounded-3xl p-5 border border-amber-500/30 space-y-3">
      <h3 class="font-black text-sm text-amber-400">Edit Data Anggota</h3>
      <input type="hidden" id="editId">
      <div>
        <label class="text-[10px] text-slate-400 font-bold">Nama Anggota</label>
        <input type="text" id="editNama" class="w-full p-2.5 glass-input rounded-xl text-xs font-bold text-white">
      </div>
      <div>
        <label class="text-[10px] text-slate-400 font-bold">Total Poin</label>
        <input type="number" id="editPoin" class="w-full p-2.5 glass-input rounded-xl text-xs font-bold text-amber-400">
      </div>
      <div class="flex gap-2 pt-2">
        <button onclick="tutupEdit()" class="w-1/2 bg-slate-800 text-slate-300 font-bold py-2 rounded-xl text-xs">Batal</button>
        <button onclick="simpanEdit()" class="w-1/2 bg-amber-500 text-slate-950 font-black py-2 rounded-xl text-xs">Simpan</button>
      </div>
    </div>
  </div>

  <script>
    let isAdmin = false;
    let listData = [];

    function toast(msg, type='success') {
      const t = document.getElementById('toast');
      t.className = `fixed top-4 left-4 right-4 md:left-auto md:w-80 z-50 p-4 rounded-2xl text-xs font-bold shadow-2xl transition-all ${type==='success'?'bg-emerald-600 text-white':'bg-rose-600 text-white'}`;
      t.textContent = msg;
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 3000);
    }

    function switchTab(tabId) {
      document.getElementById('tabLeaderboard').classList.add('hidden');
      document.getElementById('tabForm').classList.add('hidden');
      document.getElementById('nav-tabLeaderboard').className = "flex-1 py-3 border-b-2 border-transparent text-center";
      document.getElementById('nav-tabForm').className = "flex-1 py-3 border-b-2 border-transparent text-center";

      document.getElementById(tabId).classList.remove('hidden');
      document.getElementById(`nav-${tabId}`).className = "flex-1 py-3 border-b-2 border-emerald-500 text-white text-center";
    }

    function toggleAdmin() {
      if(!isAdmin) {
        const pass = prompt("Masukkan PIN Admin:");
        if(pass === "1234" || pass === "admin") {
          isAdmin = true;
          document.getElementById('btnAdmin').textContent = "Exit Admin";
          toast("Mode Admin Aktif!");
          renderData();
        } else if(pass) toast("PIN Salah!", "error");
      } else {
        isAdmin = false;
        document.getElementById('btnAdmin').innerHTML = `<i class="fa-solid fa-shield-halved mr-1"></i> Admin`;
        toast("Mode Admin Matikan");
        renderData();
      }
    }

    function hitungPoin() {
      const tilawah = parseFloat(document.getElementById('inputTilawah').value) || 0;
      const sholat = parseInt(document.getElementById('inputSholat').value) || 0;
      const olahraga = parseInt(document.getElementById('inputOlahraga').value) || 0;

      const total = Math.round((tilawah * 20) + (sholat * 2) + Math.floor(olahraga / 5));
      document.getElementById('totalPoinText').textContent = `${total} Poin`;
      return total;
    }

    // --- BACA DATA DARI FIREBASE REALTIME ---
    window.addEventListener('DOMContentLoaded', () => {
      const checkDb = setInterval(() => {
        if(window.dbMethods) {
          clearInterval(checkDb);
          const { collection, onSnapshot, query, orderBy } = window.dbMethods;
          const q = query(collection(window.db, "mutabaah"), orderBy("poin", "desc"));

          onSnapshot(q, (snapshot) => {
            listData = [];
            snapshot.forEach((doc) => {
              listData.push({ id: doc.id, ...doc.data() });
            });
            renderData();
          });
        }
      }, 200);
    });

    function renderData() {
      const podium = document.getElementById('podium');
      const list = document.getElementById('rankingList');

      if(!listData.length) {
        podium.innerHTML = '';
        list.innerHTML = `<p class="text-center text-xs text-slate-500 py-6">Belum ada data mutabaah.</p>`;
        return;
      }

      // Render Podium Top 3
      const t1 = listData[0], t2 = listData[1], t3 = listData[2];
      podium.innerHTML = `
        <div class="glass-card p-2.5 rounded-2xl text-center order-1">
          <span class="text-xs font-bold text-slate-300">🥈 #2</span>
          <p class="text-xs font-black truncate mt-1 text-slate-200">${t2 ? t2.nama : '-'}</p>
          <p class="text-xs font-black text-emerald-400">${t2 ? t2.poin : 0} pt</p>
        </div>
        <div class="glass-card p-3 rounded-2xl text-center order-2 -translate-y-2 border-amber-500/40 glow-gold">
          <span class="text-xs font-black text-amber-400">👑 #1</span>
          <p class="text-xs font-black truncate mt-1 text-amber-300">${t1 ? t1.nama : '-'}</p>
          <p class="text-sm font-black text-emerald-400">${t1 ? t1.poin : 0} pt</p>
        </div>
        <div class="glass-card p-2.5 rounded-2xl text-center order-3">
          <span class="text-xs font-bold text-amber-600">🥉 #3</span>
          <p class="text-xs font-black truncate mt-1 text-slate-200">${t3 ? t3.nama : '-'}</p>
          <p class="text-xs font-black text-emerald-400">${t3 ? t3.poin : 0} pt</p>
        </div>
      `;

      // Render List Anggota
      let html = '';
      listData.forEach((item, idx) => {
        const adminBtn = isAdmin ? `
          <div class="flex gap-1.5 ml-2">
            <button onclick="bukaEdit('${item.id}', '${item.nama}', ${item.poin})" class="p-1.5 bg-amber-500/20 text-amber-300 rounded-lg"><i class="fa-solid fa-pen"></i></button>
            <button onclick="hapusData('${item.id}')" class="p-1.5 bg-rose-500/20 text-rose-300 rounded-lg"><i class="fa-solid fa-trash"></i></button>
          </div>
        ` : '';

        html += `
          <div class="p-3 bg-slate-900/80 rounded-2xl flex justify-between items-center border border-slate-800">
            <div class="truncate">
              <p class="font-bold text-xs text-white">#${idx+1} ${item.nama}</p>
              <p class="text-[10px] text-slate-400">${item.pekan || 'Pekan Ini'}</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-black text-sm">${item.poin} pt</span>
              ${adminBtn}
            </div>
          </div>
        `;
      });
      list.innerHTML = html;
    }

    async function simpanData(e) {
      e.preventDefault();
      const nama = document.getElementById('inputNama').value.trim();
      const pekan = document.getElementById('inputPekan').value;
      const poin = hitungPoin();

      const btn = document.getElementById('btnSubmit');
      btn.disabled = true;
      btn.textContent = "Mengirim...";

      try {
        const { collection, addDoc } = window.dbMethods;
        await addDoc(collection(window.db, "mutabaah"), {
          nama: nama,
          pekan: pekan,
          poin: poin,
          createdAt: new Date()
        });

        if(window.confetti) confetti({ particleCount: 70, spread: 60 });
        toast("Data berhasil disimpan!");
        document.getElementById('inputNama').value = '';
        switchTab('tabLeaderboard');
      } catch(err) {
        toast("Gagal menyimpan data", "error");
      } finally {
        btn.disabled = false;
        btn.textContent = "Kirim Mutabaah Sekarang";
      }
    }

    // --- FITUR ADMIN EDIT & HAPUS ---
    function bukaEdit(id, nama, poin) {
      document.getElementById('editId').value = id;
      document.getElementById('editNama').value = nama;
      document.getElementById('editPoin').value = poin;
      document.getElementById('modalEdit').classList.remove('hidden');
    }

    function tutupEdit() {
      document.getElementById('modalEdit').classList.add('hidden');
    }

    async function simpanEdit() {
      const id = document.getElementById('editId').value;
      const nama = document.getElementById('editNama').value;
      const poin = Number(document.getElementById('editPoin').value);

      try {
        const { doc, updateDoc } = window.dbMethods;
        await updateDoc(doc(window.db, "mutabaah", id), { nama: nama, poin: poin });
        toast("Data berhasil diperbarui!");
        tutupEdit();
      } catch(e) {
        toast("Gagal edit data", "error");
      }
    }

    async function hapusData(id) {
      if(!confirm("Yakin ingin menghapus data anggota ini?")) return;
      try {
        const { doc, deleteDoc } = window.dbMethods;
        await deleteDoc(doc(window.db, "mutabaah", id));
        toast("Data berhasil dihapus!");
      } catch(e) {
        toast("Gagal menghapus data", "error");
      }
    }
  </script>
</body>
</html>
